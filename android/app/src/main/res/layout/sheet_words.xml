<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet: searchable list of every word the model knows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/wordsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Words EchoGesture knows"
        android:textColor="@color/text"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/wordsSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="Search, e.g. thank you"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="16sp" />

    <ListView
        android:id="@+id/wordsList"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="8dp"
        android:divider="@color/outline"
        android:dividerHeight="1dp" />
</LinearLayout>
